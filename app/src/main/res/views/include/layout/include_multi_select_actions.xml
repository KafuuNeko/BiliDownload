<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/ll_multi_select_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_floating_multi_select_bar"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <!-- 下载历史页操作（全选、导出、删除、关闭） -->
        <LinearLayout
            android:id="@+id/layout_history_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_history_selected_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/main_tab_text_active_color"
                android:textSize="@dimen/size_text_card_title"
                android:textStyle="bold"
                tools:text="已选择 2 项" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btn_history_select_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/shape_button_action_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/text_select_all"
                android:textColor="@color/main_tab_text_active_color"
                android:textSize="@dimen/size_text_common_size" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btn_history_export"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/shape_button_action_secondary"
                android:clickable="true"
                android:drawableStart="@drawable/ic_action_export"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/text_export"
                android:textColor="@color/main_tab_text_active_color"
                android:textSize="@dimen/size_text_common_size" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btn_history_delete"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/shape_button_action_delete"
                android:clickable="true"
                android:drawableStart="@drawable/ic_action_delete"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/text_delete"
                android:textColor="@color/color_delete_on_container"
                android:textSize="@dimen/size_text_common_size"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btn_history_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/text_cancel"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_action_close" />

        </LinearLayout>

        <!-- B 站资源列表页操作（取消、下载） -->
        <LinearLayout
            android:id="@+id/layout_resource_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="gone">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_cancel_multi_select"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/shape_button_action_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/text_cancel"
                android:textColor="@color/general_text_color"
                android:textSize="@dimen/size_text_button_size" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_download_multi_select"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="2"
                android:background="@drawable/shape_button_general"
                android:clickable="true"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/text_download_selected"
                android:textColor="@color/common_white"
                android:textSize="@dimen/size_text_button_size" />
        </LinearLayout>

    </LinearLayout>
</layout>
